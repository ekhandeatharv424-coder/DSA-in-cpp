
#include <iostream>
#include <string>
#include <limits>
using namespace std;

struct Employee {
    int id;
    string name;
    string department;
    float salary;
    Employee* next;
};

Employee* head = NULL;

// Create a new employee record
Employee* createNode() {
    Employee* newNode = new Employee;

    cout << "Enter Employee ID: ";
    cin >> newNode->id;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Enter Employee Name: ";
    getline(cin, newNode->name);

    cout << "Enter Department: ";
    getline(cin, newNode->department);

    cout << "Enter Salary: ";
    cin >> newNode->salary;

    newNode->next = NULL;
    return newNode;
}

// Insert employee at beginning
void insertBeginning() {
    Employee* newNode = createNode();

    newNode->next = head;
    head = newNode;

    cout << "Employee inserted at beginning.\n";
}

// Insert employee at end
void insertEnd() {
    Employee* newNode = createNode();

    if (head == NULL) {
        head = newNode;
    } else {
        Employee* temp = head;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    cout << "Employee inserted at end.\n";
}

// Delete employee using ID
void deleteEmployee() {
    if (head == NULL) {
        cout << "List is empty.\n";
        return;
    }

    int id;
    cout << "Enter Employee ID to delete: ";
    cin >> id;

    Employee* temp = head;
    Employee* prev = NULL;

    while (temp != NULL && temp->id != id) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Employee not found.\n";
        return;
    }

    if (prev == NULL) {
        head = temp->next;
    } else {
        prev->next = temp->next;
    }

    delete temp;
    cout << "Employee deleted successfully.\n";
}

// Search employee using ID
void searchEmployee() {
    int id;

    cout << "Enter Employee ID to search: ";
    cin >> id;

    Employee* temp = head;

    while (temp != NULL) {
        if (temp->id == id) {
            cout << "\nEmployee Found\n";
            cout << "ID: " << temp->id << endl;
            cout << "Name: " << temp->name << endl;
            cout << "Department: "
                 << temp->department << endl;
            cout << "Salary: " << temp->salary << endl;
            return;
        }

        temp = temp->next;
    }

    cout << "Employee not found.\n";
}

// Display all employee records
void displayEmployees() {
    if (head == NULL) {
        cout << "No employee records available.\n";
        return;
    }

    Employee* temp = head;

    cout << "\n--- Employee Records ---\n";

    while (temp != NULL) {
        cout << "ID: " << temp->id
             << " | Name: " << temp->name
             << " | Department: " << temp->department
             << " | Salary: " << temp->salary
             << endl;

        temp = temp->next;
    }
}

// Main function
int main() {
    int choice;

    do {
        cout << "\n--- Employee Management System ---\n";
        cout << "1. Insert at Beginning\n";
        cout << "2. Insert at End\n";
        cout << "3. Delete Employee\n";
        cout << "4. Search Employee\n";
        cout << "5. Display Employees\n";
        cout << "0. Exit\n";
        cout << "Enter your choice: ";

        if (!(cin >> choice)) {
            cout << "Invalid input. Program terminated.\n";
            break;
        }

        switch (choice) {
            case 1:
                insertBeginning();
                break;

            case 2:
                insertEnd();
                break;

            case 3:
                deleteEmployee();
                break;

            case 4:
                searchEmployee();
                break;

            case 5:
                displayEmployees();
                break;

            case 0:
                cout << "Program terminated.\n";
                break;

            default:
                cout << "Invalid choice. Try again.\n";
        }

    } while (choice != 0);

    // Free memory used by remaining nodes
    while (head != NULL) {
        Employee* temp = head;
        head = head->next;
        delete temp;
    }

    return 0;
}
