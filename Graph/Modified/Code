#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main()
{
    int n, e;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    vector<vector<int>> graph(n);

    cout << "Enter edges (u v):\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    int start;
    cout << "Enter starting vertex: ";
    cin >> start;

    if (start < 0 || start >= n)
    {
        cout << "Invalid starting vertex!" << endl;
        return 0;
    }

    vector<bool> visited(n, false);
    vector<int> level(n, -1);
    vector<int> traversal;

    queue<int> q;

    visited[start] = true;
    level[start] = 0;
    q.push(start);

    while (!q.empty())
    {
        int current = q.front();
        q.pop();

        traversal.push_back(current);

        for (int neighbor : graph[current])
        {
            if (!visited[neighbor])
            {
                visited[neighbor] = true;
                level[neighbor] = level[current] + 1;
                q.push(neighbor);
            }
        }
    }

    cout << "\nBFS Traversal Order: ";
    for (int vertex : traversal)
        cout << vertex << " ";

    cout << "\nReachable Vertices: ";
    int count = 0;

    for (int i = 0; i < n; i++)
    {
        if (visited[i])
        {
            cout << i << " ";
            count++;
        }
    }

    cout << "\nUnvisited Vertices: ";
    bool found = false;

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";

    cout << "\nNumber of Reachable Vertices: "
         << count;

    cout << "\n\nBFS Levels:\n";

    for (int i = 0; i < n; i++)
    {
        if (visited[i])
            cout << "Vertex " << i
                 << " : Level " << level[i] << endl;
    }

    return 0;
}
