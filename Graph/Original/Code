#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void BFS(vector<vector<int>>& graph, int source)
{
    int n = graph.size();

    vector<bool> visited(n, false);
    queue<int> q;
    vector<int> reachable;

    visited[source] = true;
    q.push(source);

    while (!q.empty())
    {
        int current = q.front();
        q.pop();

        reachable.push_back(current);

        for (int neighbour : graph[current])
        {
            if (!visited[neighbour])
            {
                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }

    cout << "\nReachable fields: ";
    for (int field : reachable)
    {
        cout << field + 1 << " ";
    }

    cout << "\nUnreachable fields: ";
    bool found = false;

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            cout << i + 1 << " ";
            found = true;
        }
    }

    if (!found)
    {
        cout << "None";
    }

    cout << endl;
}

int main()
{
    int n, e;

    cout << "Enter number of farm fields: ";
    cin >> n;

    cout << "Enter number of irrigation channels: ";
    cin >> e;

    vector<vector<int>> graph(n);

    cout << "Enter the connected field pairs:\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        if (u < 1 || u > n || v < 1 || v > n)
        {
            cout << "Invalid field number!" << endl;
            return 1;
        }

        graph[u - 1].push_back(v - 1);
        graph[v - 1].push_back(u - 1);
    }

    int source;

    cout << "Enter the water source field: ";
    cin >> source;

    if (source < 1 || source > n)
    {
        cout << "Invalid source field!" << endl;
        return 1;
    }

    BFS(graph, source - 1);

    return 0;
}
